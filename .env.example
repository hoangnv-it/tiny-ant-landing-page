# Sao chép thành .env.local và điền giá trị. Không commit file .env thật.
# Site key Cloudflare Turnstile (public, dùng ở client)
VITE_TURNSTILE_SITE_KEY=
# URL nhận form đăng ký dùng thử (web app Apps Script, xem apps-script/README.md)
VITE_LEAD_ENDPOINT=
# Mã dự án Microsoft Clarity (mặc định z5p0ldxa1j). Đặt rỗng để tắt tracking.
# VITE_CLARITY_ID=
