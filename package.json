    "og-image": "node scripts/og-image.mjs",
    "check:seo": "node scripts/seo-check.mjs",
    "check:lighthouse": "node scripts/lighthouse.mjs",
    "check:a11y": "node scripts/a11y-check.mjs"
  },
  "dependencies": {
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
